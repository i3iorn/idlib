{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/client-schema.json",
  "title": "Clients",
  "description": "Schema for the clients.json file.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/client"
  },
  "required": ["id", "name"],
  "$defs": {
    "client": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "The unique identifier for the client. This is used to identify the client in the system."
        },
        "clientSecretKey": {
          "type": "string",
          "description": "Id for the secret key. Not the secret itself."
        },
        "associatedServer": {
          "type": "string",
          "description": "The token server url associated with the client."
        },
        "rulesetKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rulesetKey"
          }
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "customerCode": {
          "type": "string",
          "description": "The customer code associated with the client."
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "The scope associated with the client."
          }
        },
        "notes": {
          "type": "string",
          "description": "Notes associated with the client."
        },
        "internalClient": {
          "type": "boolean",
          "description": "Indicates if the client is an internal client.",
          "default": false
        }
      },
      "required": ["clientId", "clientSecretKey", "associatedServer", "environment", "internalClient"],
      "additionalProperties": false,
      "description": "Client object representing a client in the system."
    },
    "rulesetKey": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "The unique identifier for the ruleset key."
        },
        "channel": {
          "type": "string",
          "enum": ["b2b", "b2c"]
        },
        "country": {
          "$ref": "#/$defs/nordicCountry"
        },
        "notes": {
          "type": "string",
          "description": "Notes associated with the ruleset key."
        }
      },
      "examples": ["1-3daf-4a2b-8c3e", "1-d5c6-f3a1-e5h1", "1-2a3b-4c5d-6e7f"],
      "required": ["key", "channel", "country"],
      "additionalProperties": false,
      "description": "Ruleset key object representing a ruleset key in the system."
    },
    "country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code.",
      "pattern": "^[A-Z]{2}$"
    },
    "nordicCountry": {
      "type": "string",
      "enum": ["SE", "NO", "FI", "DK"],
      "description": "Nordic countries.",
      "examples": ["SE", "NO", "FI", "DK"]
    },
    "environment": {
      "type": "string",
      "enum": ["production", "prodtest", "sandbox"],
      "description": "The environment in which the client operates.",
      "examples": ["production", "prodtest", "sandbox"]
    }
  }
}
