{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/clients-schema.json",
  "title": "Clients",
  "description": "Schema for the clients.json file.",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the client schema.",
      "examples": ["8da67c3b-477b-414c-a67c-3b477bb14caf"],
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "description": "Name of the client specification.",
      "examples": ["Clients"]
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "clients": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/client"
      },
      "description": "List of clients.",
      "examples": [
        {
          "host": "api.bisnode.com",
          "clientId": "123456",
          "clientSecretKey": "1dd1bb79-dc8e-4a59-aaf2-b2a100613ef5",
          "associatedServer": "https://login.bisnode.com/as/token.oauth2",
          "environment": "production",
          "customerCode": "TLG9",
          "scopes": [
            "b2b_aml_screen",
            "b2c_aml_screen"
          ],
          "notes": "Zandras AML Client",
          "internalClient": true,
          "clientType": "dnbClient",
          "rulesetKeys": [
            {
              "key": "1-3daf-4a2b-8c3e",
              "channel": "b2b",
              "country": "SE",
              "notes": "Example ruleset key"
            }
          ]
        }
      ],
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "name",
    "meta",
    "clients"
  ],
  "$defs": {
    "client": {
      "oneOf": [
        { "$ref": "#/$defs/simpleClient" },
        { "$ref": "#/$defs/dnbClient" }
      ],
      "discriminator": {
        "propertyName": "clientType",
        "mapping": {
          "simpleClient": "#/$defs/simpleClient",
          "dnbClient":  "#/$defs/dnbClient"
        }
      }
    },
    "baseClient": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the client"
        },
        "host": { "type": "string", "description": "Client’s base URL"
        },
        "notes": { "type": "string", "description": "Admin notes" },
        "internalClient": { "type": "boolean" },
        "clientType": {
          "type": "string",
          "enum": ["simpleClient", "dnbClient"],
          "description": "Type of client"
        },
        "auth": {
            "$ref": "#/$defs/auth",
            "description": "Authentication information for the client."
        }
      }
    },
    "simpleClient": {
      "allOf": [
        { "$ref": "#/$defs/baseClient" },
        {
          "properties": {
              "clientType": { "const": "simpleClient" }
          },
          "required": ["host", "clientType", "internalClient", "auth", "name"],
          "additionalProperties": false
        }
      ]
    },
    "dnbClient": {
      "allOf": [
        { "$ref": "#/$defs/baseClient" },
        { "$ref": "#/$defs/environment" },
        {
          "type": "object",
          "properties": {
            "rulesetKeys": {
              "type": "array", "items": { "$ref": "#/$defs/rulesetKey" }, "minItems": 0
            },
            "customerCode": { "type": "string", "pattern": "^[A-Z0-9]{4,8}$" },
            "clientType": { "const": "dnbClient" }
          },
          "required": ["host", "clientType", "internalClient", "auth", "name", "environment", "customerCode"],
          "additionalProperties": false
        }
      ],
      "description": "DNB-specific client"
    },
    "rulesetKey": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "The unique identifier for the ruleset key.",
          "pattern": "^[0-9]-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}$",
          "examples": ["1-3daf-4a2b-8c3e", "1-d5c6-f3a1-e5h1", "1-2a3b-4c5d-6e7f"]
        },
        "channel": {
          "type": "string",
          "enum": ["b2b", "b2c"],
          "description": "The channel for which the ruleset key is applicable."
        },
        "country": {
          "$ref": "#/$defs/nordicCountry"
        },
        "notes": {
          "type": "string",
          "description": "Notes associated with the ruleset key."
        }
      },
      "required": ["key", "channel", "country"],
      "additionalProperties": false,
      "description": "Ruleset key object representing a ruleset key in the system."
    },
    "country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code.",
      "pattern": "^[A-Z]{2}$"
    },
    "nordicCountry": {
      "allOf": [
        { "$ref": "#/$defs/country" },
        { "enum": ["SE", "NO", "FI", "DK"] }
      ]
    },
    "environment": {
      "type": "string",
      "enum": ["production", "prodtest", "sandbox"],
      "description": "The environment in which the client operates.",
      "examples": ["production", "prodtest", "sandbox"]
    },
    "auth": {
      "allOf": [
        { "$ref": "#/$defs/general" },
        { "oneOf": [
            { "$ref": "#/$defs/clientCredentials" },
            { "$ref": "#/$defs/basicAuth" },
            { "$ref": "#/$defs/tokenAuth" }
          ]
        }
      ]
    },
    "general": {
      "type": "object",
      "properties": {
        "associatedServer": {
          "type": "string",
          "description": "The server associated with the client.",
          "format": "uri"
        }
      }
    },
    "clientCredentials": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "Unique client identifier",
          "examples": ["123456", "654321"]
        },
        "clientSecretKey": {
          "type": "string",
          "writeOnly": true,
          "description": "Secret key ID (write-only). This is a id for the secret, not the secret itself",
          "examples": ["1dd1bb79-dc8e-4a59-aaf2-b2a100613ef5"]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Scopes for the client."
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "associatedServer": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["clientId", "clientSecretKey", "associatedServer", "scopes"],
      "additionalProperties": false
    },
    "basicAuth": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Username for basic authentication."
        },
        "password": {
          "type": "string",
          "description": "Password for basic authentication."
        }
      },
      "required": [
        "username",
        "password"
      ],
      "additionalProperties": false,
      "description": "Basic authentication information."
    },
    "tokenAuth": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "Token for token-based authentication."
        }
      },
      "required": [
        "token"
      ],
      "additionalProperties": false,
      "description": "Token-based authentication information."
    },
    "meta": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "description": "Version of the schema.",
          "examples": ["1.0.0"]
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp."
        }
      },
      "required": ["version", "lastUpdated"],
      "additionalProperties": false
    }
  }
}